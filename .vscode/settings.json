{
	"files.exclude": {
		"**/node_modules": true,
		"**/.next": true,
		"**/coverage": true,
		"**/dist": true,
		"**/.turbo": true
	},
	"search.exclude": {
		"**/node_modules": true,
		"**/.next": true,
		"**/coverage": true,
		"**/dist": true,
		"**/package-lock.json": true,
		"**/pnpm-lock.yaml": true
	},
	"files.watcherExclude": {
		"**/node_modules/**": true,
		"**/.next/**": true,
		"**/coverage/**": true,
		"**/dist/**": true,
		"**/.git/objects/**": true
	},
	"typescript.tsdk": "node_modules/typescript/lib",
	"typescript.enablePromptUseWorkspaceTsdk": true,
	"typescript.tsserver.experimental.enableProjectDiagnostics": false
}
